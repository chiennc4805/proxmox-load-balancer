# Bare hostname defaults to https://<host>:8006.
# A complete URL uses its explicit scheme/port, e.g. https://pve.example.edu:8006.
PVE_API_HOST=proxmox.example.edu
PVE_API_USER=api-user@pve
PVE_TOKEN_NAME=malsec-api
PVE_TOKEN_VALUE=replace-with-the-proxmox-token-secret
PVE_VERIFY_SSL=true
# Timeout for upstream connection/read; no automatic request retry.
PVE_REQUEST_TIMEOUT_SECONDS=30

# Compose: docker compose --env-file src/app/.env up -d --build
POSTGRES_USER=gateway
POSTGRES_DB=gateway
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=5433
# Local Python process; Compose overrides the host/port for containers.
DATABASE_DSN=postgresql://gateway:replace-with-a-local-database-password@127.0.0.1:5433/gateway
CLUSTER_KEY=dev
SHARED_STORAGE=nas-nfs
TRACKER_INTERVAL_SECONDS=3
TRACKER_CONCURRENCY=4
