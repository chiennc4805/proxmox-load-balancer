# Bare hostname defaults to https://<host>:8006.
# A complete URL uses its explicit scheme/port, e.g. https://pve.example.edu:8006.
PVE_API_HOST=proxmox.example.edu
PVE_API_USER=api-user@pve
PVE_TOKEN_NAME=malsec-api
PVE_TOKEN_VALUE=replace-with-the-proxmox-token-secret
PVE_VERIFY_SSL=true
# Timeout for upstream connection/read; no automatic request retry.
PVE_REQUEST_TIMEOUT_SECONDS=30
