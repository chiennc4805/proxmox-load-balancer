# IP/DNS cua mot node Proxmox ma backend truy cap duoc; khong them https://
PVE_API_HOST=10.10.0.11
PVE_API_USER=malsec-api@pve
PVE_TOKEN_NAME=malsec-token
PVE_TOKEN_VALUE=THAY_BANG_TOKEN_CUA_BAN
# Lab dung chung chi tu ky; chi bat true khi da co chung chi duoc tin cay.
PVE_VERIFY_SSL=false

# Keep these values aligned with malsec-custom/.env.
LAB_NETWORK_CIDR=172.20.20.0/24
TEMPLATE_VMID_MIN=9000
TEMPLATE_VMID_MAX=9999
STUDENT_VMID_MIN=5000
STUDENT_VMID_MAX=5999
DEFAULT_TEMPLATE_VMID=9001
VM_PROTOCOL_PORTS=rdp:3389,vnc:5900,ssh:22
DEFAULT_VM_PROTOCOL=ssh
VM_CLONE_TIMEOUT_SECONDS=900
VM_CONNECTION_TIMEOUT_SECONDS=180
VM_AGENT_TIMEOUT_SECONDS=180
VM_BOOT_WAIT_SECONDS=15
VM_VERIFY_CONNECTION=false

# DB noi bo cho cau hinh scheduler, job state va round-robin cursor.
POSTGRES_PASSWORD=THAY_BANG_MAT_KHAU_DB
# Key dung cho GET/PUT /api/admin/scheduler. Khong dua vao frontend source.
ADMIN_API_KEY=THAY_BANG_CHUOI_BI_MAT_DAI

# Shared secret required by VM clone endpoints. Configure the same value in MalSec.
PROXMOX_LB_SERVICE_KEY=THAY_BANG_CHUOI_BI_MAT_DAI_KHAC
