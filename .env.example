# IP/DNS của một node Proxmox mà backend truy cập được; không thêm https://
PVE_API_HOST=10.10.0.11
PVE_API_USER=malsec-api@pve
PVE_TOKEN_NAME=malsec-token
PVE_TOKEN_VALUE=THAY_BANG_TOKEN_CUA_BAN
# Lab dùng chứng chỉ tự ký; chỉ bật true khi đã có chứng chỉ được tin cậy.
PVE_VERIFY_SSL=false
# Ưu tiên IP trong subnet này; DHCP ở subnet khác vẫn được nhận.
LAB_NETWORK_CIDR=172.20.11.0/24
VM_CLONE_TIMEOUT_SECONDS=300
VM_AGENT_TIMEOUT_SECONDS=180

# DB nội bộ cho cấu hình scheduler và node vừa được chọn. Thay bằng mật khẩu mạnh.
POSTGRES_PASSWORD=THAY_BANG_MAT_KHAU_DB
# Key dùng cho GET/PUT /api/admin/scheduler. Không đưa vào frontend source.
ADMIN_API_KEY=THAY_BANG_CHUOI_BI_MAT_DAI
